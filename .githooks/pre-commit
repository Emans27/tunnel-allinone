#!/usr/bin/env bash
# Blokir commit yang memuat secret: bot token, GitHub PAT, AWS key, private key,
# chat ID. Data runtime (/etc/mytunnel/config/*, db/*, cert/*) memang tidak pernah
# ada di repo, tapi guard ini menangkap salah-tempel dari VPS atau wizard.
set -uo pipefail

fail=0
report() { printf '  %s\n' "$1" >&2; fail=1; }

# pola digabung: <deskripsi>|<regex>
PATTERNS='bot_token (Telegram bot token)|\b[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}\b
github_pat (GitHub PAT)|\bgh[pousr]_[A-Za-z0-9]{20,}\b
aws_key (AWS access key)|\bAKIA[0-9A-Z]{16}\b
private_key (private key)|-----BEGIN [A-Z ]*PRIVATE KEY-----
admin_chat_id (Telegram chat ID)|\bADMIN_ID\s*=\s*"?[0-9]{8,12}"?'

staged=$(git diff --cached --name-only --diff-filter=ACMR)

for f in $staged; do
    # lewati biner: bytes non-UTF8 / ada NUL
    if git show ":$f" 2>/dev/null | LC_ALL=C grep -qP '\x00' 2>/dev/null; then
        continue
    fi
    content=$(git show ":$f" 2>/dev/null)
    while IFS= read -r entry; do
        label=${entry%%|*}; rx=${entry#*|}
        # dokumentasi yang memang harus pakai placeholder diizinkan
        if printf '%s' "$content" \
            | grep -aoE -- "$rx" \
            | grep -avE '^<BOT_TOKEN>$|^<BOT_ID>$|^123456789:AAH\*+$|^xxx+$' \
            | grep -q .; then
            printf 'SECRET TERDETEKSI: %s\n  file: %s\n' "$label" "$f" >&2
            printf '%s' "$content" | grep -anE -- "$rx" | head -3 | cut -c1-100 | sed 's/^/  /' >&2
            report "  (isi bagian yang dicoret atau pakai placeholder)"
        fi
    done <<EOF
$PATTERNS
EOF
done

# path yang tidak boleh masuk repo sama sekali
for f in $staged; do
    case "$f" in
        cert/*|*/private.key|*/bot.conf|db/*.txt|*/.env|*.pem|*.key)
            report "PATH TERLARANG: $f";;
    esac
done

# --- SHA256SUMS harus sinkron dengan file yang di-commit ---
_sums_check() {
    local sums=SHA256SUMS _stale=() _want _have _f
    [ -f "$sums" ] || return 0
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || return 0
    while IFS= read -r _f; do
        [ -f "$_f" ] || continue
        _want=$(awk -v n="$_f" '$2==n {print $1; exit}' "$sums" 2>/dev/null)
        [ -n "$_want" ] || continue
        _have=$(sha256sum "$_f" 2>/dev/null | awk '{print $1}')
        [ "$_want" = "$_have" ] || _stale+=("$_f")
    done <<'SUMSEOF'
install.sh
uninstall.sh
VERSION
CHANGELOG.md
README.md
ports.conf
configure-final-443.sh
LICENSE
SUMSEOF
    [ ${#_stale[@]} -eq 0 ] || report "SHA256SUMS basi: ${_stale[*]}"
}

if [ "$fail" -eq 0 ]; then
    _sums_check
fi

if [ "$fail" -ne 0 ]; then
    printf '\nCommit DITOLAK. Bersihkan secret di atas, lalu `git add` ulang.\n' >&2
    exit 1
fi
exit 0
# tweak hook
